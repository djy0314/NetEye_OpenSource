<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>5</LangVersion>
    <AssemblyName>NetEye</AssemblyName>
    <RootNamespace>NetEye</RootNamespace>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationManifest>..\src\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\NetTable.cs" />
    <Compile Include="..\src\Theme.cs" />
    <Compile Include="..\src\ProcBadge.cs" />
    <Compile Include="..\src\ProcAge.cs" />
    <Compile Include="..\src\NetSpeed.cs" />
    <Compile Include="..\src\SettingsForm.cs" />
    <Compile Include="..\src\Qqwry.cs" />
    <Compile Include="..\src\LibUpdater.cs" />
    <Compile Include="..\src\ProcIcons.cs" />
    <Compile Include="..\src\SpeedGraph.cs" />
    <Compile Include="..\src\AppConfig.cs" />
    <Compile Include="..\src\DonateImage.cs" />
    <Compile Include="..\src\DonateForm.cs" />
    <Compile Include="..\src\MainForm.cs" />
    <Compile Include="..\src\NetEyeApp.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
